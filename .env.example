# Preferred on Netlify Neon extension
NETLIFY_DATABASE_URL=postgresql://username:password@host/dbname?sslmode=require

# Alternative names accepted by server diagnostics
NEON_DATABASE_URL=postgresql://username:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://username:password@host/dbname?sslmode=require

# App URL (Netlify or local)
URL=http://localhost:8080

# Server-side JWT secret used for auth verification helpers
JWT_SECRET=replace_with_long_random_secret
